# ─── TLMS Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Server
PORT=3000

# Session secret
SESSION_SECRET=change-this-to-a-long-random-secret-before-deploying

# Environment: development | production
NODE_ENV=development

# Database — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Cloudflare R2 — nightly backup ──────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tlms-backups
# R2_ENDPOINT is built from R2_ACCOUNT_ID automatically; override only if needed
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
