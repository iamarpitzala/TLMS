# ─── TLMS Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values before running in production.

# Server
PORT=3000

# Session secret — change this to a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-before-deploying

# Environment: development | production
NODE_ENV=development
